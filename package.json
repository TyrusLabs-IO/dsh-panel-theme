{
  "name": "dsh-panel-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Configurable sidebar background theme for DeepSeek Harness: gradient, glow, opacity, presets and JSON backup.",
  "license": "MIT",
  "author": "TyrusLabs-IO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TyrusLabs-IO/dsh-panel-theme.git"
  },
  "homepage": "https://github.com/TyrusLabs-IO/dsh-panel-theme#readme",
  "bugs": {
    "url": "https://github.com/TyrusLabs-IO/dsh-panel-theme/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "sidebar",
    "sidebar-theme"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
